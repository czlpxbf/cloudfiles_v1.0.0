# ============================================================
# Cloudfiles 环境变量示例（复制为 .env / .dev.vars 并填入真实值）
# API Token 最小权限：Cloudflare Pages:Edit（Account 级）
# ============================================================

# Cloudflare 账号 ID（dashboard 右侧栏可查）
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token（仅 Pages:Edit 权限，存为 secret，绝不入库）
CLOUDFLARE_API_TOKEN=

# 用户 Pages 项目名前缀（注册用户将获得 {prefix}-{username}-main / -data）
CF_PROJECT_PREFIX=cf

# JWT 签名密钥（任意长随机串，建议 `openssl rand -hex 32`）
JWT_SECRET=

# 环境：development | production（development 下允许 CORS 本地开发）
CF_ENV=development
